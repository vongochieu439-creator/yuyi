# 羽翼Pro V2 - 环境变量配置示例
# 复制此文件为 .env 并填入真实的API密钥

# ==================== NanoBanana API配置 ====================
# 图片生成API（Fal.ai平台）
# 获取方式：联系热梦百科API平台 https://api.remenbaike.com
NANOBANANA_API_KEY=your_api_key_here
NANOBANANA_API_BASE_URL=https://api.remenbaike.com

# ==================== Kling API配置 ====================
# 图生视频API
# 使用相同的API Key即可
KLING_API_KEY=your_api_key_here
KLING_API_BASE_URL=https://api.remenbaike.com

# ==================== 可选：AI评分服务 ====================
# GPT-4 Vision API（用于图片质量评分）
# 如果不配置，将使用占位评分系统
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ==================== 可选：提示词优化服务 ====================
# GPT-4 API（用于提示词优化）
# 如果不配置，将使用规则优化系统
# PROMPT_OPTIMIZER_API_KEY=sk-...

# ==================== Web服务器配置 ====================
# 端口（默认8080）
# WEB_PORT=8080

# 主机（默认0.0.0.0，允许外部访问）
# WEB_HOST=0.0.0.0

# ==================== 日志配置 ====================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
# LOG_LEVEL=INFO
